<settings xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.1.0 http://maven.apache.org/xsd/settings-1.1.0.xsd"
          xmlns="http://maven.apache.org/SETTINGS/1.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">


    <servers>
        <server>
            <id>nexus</id>
            <username>${env.NEXUS_LOGIN}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
        <server>
            <id>inhouse.snapshot</id>
            <username>${env.NEXUS_LOGIN}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
        <server>
            <id>inhouse</id>
            <username>${env.NEXUS_LOGIN}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
    </servers>

    <mirrors>

        <mirror>
            <id>Nexus.proxy.central</id>
            <mirrorOf>central</mirrorOf>
            <name>Nexus Proxy mirroring central (maven 2) repository</name>
            <url>https://nexus-ein.com.intraMyProject/repository/proxy-maven/</url>
        </mirror>

    </mirrors>
</settings>